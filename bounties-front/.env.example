# API
NEXT_PUBLIC_API_URL=https://www.apibounties.com

# Host pending-activation screen: Telegram @username or t.me URL (optional; default nidodotglobal)
NEXT_PUBLIC_SUPPORT_TELEGRAM=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Twitter
TWITTER_API_KEY=

# JWT (usado pelo middleware para validar assinatura)
JWT_SECRET=

# Google Analytics
NEXT_PUBLIC_GA_ID=

# Stellar (public values only — never put secret keys here)
# "mainnet" → public network, "testnet" → test network
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
